# ==========================================
# 편리 (Pyeonri) - 환경 변수 설정 템플릿
# 이 파일을 복사해서 '.env' 파일을 만든 뒤 실제 키 값을 입력하세요.
# (주의: 실제 키가 들어간 .env 파일은 절대 커밋하지 마세요)
# ==========================================

# Google Gemini API Key (AI 카테고리 분류용)
# 발급처: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Kakao REST API Key (필요 시 매장/경로 서비스용)
# KAKAO_REST_API_KEY=your_kakao_api_key_here

